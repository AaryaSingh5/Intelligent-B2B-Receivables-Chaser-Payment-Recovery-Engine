# ─── Revenue Recovery Engine — Environment Configuration ───────────────────
#
# Copy this file to .env and fill in your keys.
# The engine runs fully offline with template-based messaging by default.
# LLM keys are optional and reserved for future AI-powered message generation.

# Optional: OpenAI / Gemini API key for AI-powered message drafting (future)
LLM_API_KEY=your-api-key-here

# Optional: Razorpay API keys (for future live payment retry integration)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum nudge attempts before stopping (default: 2)
MAX_NUDGES=2

# Compliance aging threshold in days (default: 30)
COMPLIANCE_AGING_THRESHOLD=30

# ─── WhatsApp Dispatch via Twilio ──────────────────────────────────────────
#
# Leave ENABLE_LIVE_WHATSAPP=false (default) to run in dry-run / simulation
# mode — all messages are generated and logged but NO real API calls are made.
#
# To enable live WhatsApp delivery:
#   1. Create a free Twilio account at https://www.twilio.com
#   2. Join the WhatsApp Sandbox: Twilio Console → Messaging → Try it out → WhatsApp
#   3. Fill in the three keys below and set ENABLE_LIVE_WHATSAPP=true
#   4. Add target phone numbers (E.164 format, e.g. +919876543210) to ALLOWED_RECIPIENTS
#
# IMPORTANT: Only numbers in ALLOWED_RECIPIENTS will receive live messages.
# This is a hard safety guardrail that prevents accidental mass-sending.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_NUMBER=+14155238886

# Set to "true" to enable live WhatsApp delivery (default: false = dry-run)
ENABLE_LIVE_WHATSAPP=false

# Comma-separated allowlist of E.164 phone numbers that may receive live messages
# Example: ALLOWED_RECIPIENTS=+919876543210,+919123456789
ALLOWED_RECIPIENTS=
