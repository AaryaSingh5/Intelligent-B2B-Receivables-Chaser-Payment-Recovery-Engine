# ─── Revenue Recovery Engine — Environment Configuration ───────────────────
#
# Copy this file to .env and fill in your keys.
# The engine runs fully offline with template-based messaging by default.
# LLM keys are optional and reserved for future AI-powered message generation.

# Optional: OpenAI / Gemini API key for AI-powered message drafting (future)
LLM_API_KEY=your-api-key-here

# Optional: Razorpay API keys (for future live payment retry integration)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum nudge attempts before stopping (default: 2)
MAX_NUDGES=2

# Compliance aging threshold in days (default: 30)
COMPLIANCE_AGING_THRESHOLD=30
